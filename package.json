{
  "name": "dsh-offpeak",
  "version": "3.3.9",
  "type": "module",
  "description": "可配置峰谷自动会话门：config/offpeak.json 驱动 peak 时段 + 周末全天 off-peak + 单会话「畅跑」限时无视峰谷 + 高峰自动暂停/波谷自动恢复 + 按模型名的高峰拦截列表。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "peak",
    "off-peak",
    "weekend",
    "pause",
    "freeze",
    "retry",
    "session-gate",
    "time-policy",
    "free-run"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lizilong1993/dsh-offpeak.git"
  },
  "homepage": "https://github.com/lizilong1993/dsh-offpeak",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "lib/",
    "config/",
    "assets/",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src tests",
    "test": "node --test \"tests/*.test.mjs\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20",
    "dsh": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "~18.3.1",
    "eslint": "^10.8.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0"
  }
}
